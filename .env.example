DATABASE_URL="postgresql://user:password@localhost:5432/schedmaster"
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_NAME=SchedMaster
MAIL_FROM_NAME=SchedMaster
MAIL_FROM_EMAIL=no-reply@example.invalid

# Mail and 2FA secrets must be configured outside source control.
BREVO_API_KEY=
TWO_FA_CODE_SECRET=
TWO_FA_CODE_TTL_MINUTES=2
TWO_FA_MAX_ATTEMPTS=5
TWO_FA_MAX_SENDS=3
TWO_FA_RESEND_COOLDOWN_SECONDS=60
DISABLE_LOGIN_2FA=false

# Cloudinary image storage for anuncios.
# You can either set CLOUDINARY_URL or the three separate values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=schedmaster

# Optional local seed for privileged users. Never commit real values here.
SEED_PRIVILEGED_USERS=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TRAINER_EMAIL=
SEED_TRAINER_PASSWORD=
